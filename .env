# ===== cascade =====
# When running notebooks from VS Code (.venv kernel) on the host,
# connect to the Docker Postgres via localhost:5432 (mapped in docker-compose).
DB_CONFIG=postgresql+psycopg2://postgres:postgres@localhost:5432/cascade
# No SAMPLE_DIR or BASE_TABLE_FOR_SAMPLE_OVERRIDE: run schema-only without CSV samples
# SAMPLE_DIR=
# BASE_TABLE_FOR_SAMPLE_OVERRIDE=
TARGET_ROWS_PER_TABLE=1000000
BATCH_SIZE=200000
USE_EXISTING_DATA_PROFILE=false
VALIDATE_FK=false

