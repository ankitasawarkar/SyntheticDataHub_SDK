EDL_VERSION = "1.0"

// ---------- CORE ENTITIES ----------

ENTITY Customer {
	DESCRIPTION = "Customer master information"

	ATTRIBUTE customer_id {
		TYPE = STRING
		LENGTH = 36
		REQUIRED = TRUE
	}

	ATTRIBUTE first_name {
		TYPE = STRING
		LENGTH = 50
		REQUIRED = TRUE
	}

	ATTRIBUTE last_name {
		TYPE = STRING
		LENGTH = 50
		REQUIRED = TRUE
	}

	ATTRIBUTE date_of_birth {
		TYPE = DATE
		REQUIRED = TRUE
	}

	ATTRIBUTE email {
		TYPE = EMAIL
		LENGTH = 100
		REQUIRED = FALSE
	}

	ATTRIBUTE ssn {
		TYPE = SSN
		LENGTH = 11
		REQUIRED = FALSE
	}

	ATTRIBUTE marketing_opt_in {
		TYPE = INT
		REQUIRED = FALSE
	}

	ATTRIBUTE loyalty_points {
		TYPE = INT
		REQUIRED = FALSE
	}

	ATTRIBUTE created_at {
		TYPE = TIMESTAMP
		REQUIRED = TRUE
	}

	ATTRIBUTE kyc_status {
		TYPE = STRING
		LENGTH = 20
		REQUIRED = TRUE
		ALLOWED_VALUES = ["PENDING", "VERIFIED", "REJECTED"]
	}

	PRIMARY KEY (customer_id)
}

ENTITY Branch {
	DESCRIPTION = "Bank branches"

	ATTRIBUTE branch_id {
		TYPE = STRING
		LENGTH = 16
		REQUIRED = TRUE
	}

	ATTRIBUTE branch_name {
		TYPE = STRING
		LENGTH = 100
		REQUIRED = TRUE
	}

	ATTRIBUTE city {
		TYPE = STRING
		LENGTH = 50
		REQUIRED = TRUE
	}

	ATTRIBUTE country {
		TYPE = STRING
		LENGTH = 50
		REQUIRED = TRUE
	}

		ATTRIBUTE employee_count {
			TYPE = INT
			REQUIRED = FALSE
		}

	PRIMARY KEY (branch_id)
}

ENTITY Account {
	DESCRIPTION = "Customer accounts"

	ATTRIBUTE account_id {
		TYPE = STRING
		LENGTH = 24
		REQUIRED = TRUE
	}

	ATTRIBUTE customer_id {
		TYPE = STRING
		LENGTH = 36
		REQUIRED = TRUE
	}

	ATTRIBUTE branch_id {
		TYPE = STRING
		LENGTH = 16
		REQUIRED = TRUE
	}

	ATTRIBUTE account_type {
		TYPE = STRING
		LENGTH = 20
		REQUIRED = TRUE
		ALLOWED_VALUES = ["SAVINGS", "CHECKING", "CREDIT", "LOAN"]
	}

	ATTRIBUTE currency {
		TYPE = STRING
		LENGTH = 3
		REQUIRED = TRUE
	}

	ATTRIBUTE opened_date {
		TYPE = DATE
		REQUIRED = TRUE
	}

	ATTRIBUTE status {
		TYPE = STRING
		LENGTH = 20
		REQUIRED = TRUE
		ALLOWED_VALUES = ["ACTIVE", "BLOCKED", "CLOSED"]
	}

	ATTRIBUTE current_balance {
		TYPE = DECIMAL
		PRECISION = 18
		SCALE = 2
		REQUIRED = TRUE
	}

	PRIMARY KEY (account_id)

	FOREIGN KEY (customer_id) REFERENCES Customer(customer_id)
	FOREIGN KEY (branch_id)   REFERENCES Branch(branch_id)
}

ENTITY Card {
	DESCRIPTION = "Payment cards linked to accounts"

	ATTRIBUTE card_id {
		TYPE = STRING
		LENGTH = 24
		REQUIRED = TRUE
	}

	ATTRIBUTE account_id {
		TYPE = STRING
		LENGTH = 24
		REQUIRED = TRUE
	}

	ATTRIBUTE card_number {
		TYPE = STRING
		LENGTH = 16
		REQUIRED = TRUE
	}

	ATTRIBUTE card_type {
		TYPE = STRING
		LENGTH = 20
		REQUIRED = TRUE
		ALLOWED_VALUES = ["DEBIT", "CREDIT"]
	}

	ATTRIBUTE issued_date {
		TYPE = DATE
		REQUIRED = TRUE
	}

	ATTRIBUTE expiry_date {
		TYPE = DATE
		REQUIRED = TRUE
	}

	ATTRIBUTE status {
		TYPE = STRING
		LENGTH = 20
		REQUIRED = TRUE
		ALLOWED_VALUES = ["ACTIVE", "BLOCKED", "EXPIRED"]
	}

	PRIMARY KEY (card_id)

	FOREIGN KEY (account_id) REFERENCES Account(account_id)
}

ENTITY Merchant {
	DESCRIPTION = "Merchants accepting card payments"

	ATTRIBUTE merchant_id {
		TYPE = STRING
		LENGTH = 24
		REQUIRED = TRUE
	}

	ATTRIBUTE merchant_name {
		TYPE = STRING
		LENGTH = 100
		REQUIRED = TRUE
	}

	ATTRIBUTE category {
		TYPE = STRING
		LENGTH = 50
		REQUIRED = TRUE
	}

	ATTRIBUTE country {
		TYPE = STRING
		LENGTH = 50
		REQUIRED = TRUE
	}

	PRIMARY KEY (merchant_id)
}

ENTITY Transaction {
	DESCRIPTION = "Account-level financial transactions"

	ATTRIBUTE txn_id {
		TYPE = STRING
		LENGTH = 32
		REQUIRED = TRUE
	}

	ATTRIBUTE account_id {
		TYPE = STRING
		LENGTH = 24
		REQUIRED = TRUE
	}

	ATTRIBUTE card_id {
		TYPE = STRING
		LENGTH = 24
		REQUIRED = FALSE
	}

	ATTRIBUTE merchant_id {
		TYPE = STRING
		LENGTH = 24
		REQUIRED = FALSE
	}

	ATTRIBUTE txn_timestamp {
		TYPE = TIMESTAMP
		REQUIRED = TRUE
	}

	ATTRIBUTE amount {
		TYPE = DECIMAL
		PRECISION = 18
		SCALE = 2
		REQUIRED = TRUE
	}

	ATTRIBUTE currency {
		TYPE = STRING
		LENGTH = 3
		REQUIRED = TRUE
	}

	ATTRIBUTE exchange_rate {
		TYPE = DOUBLE
		REQUIRED = FALSE
	}

	ATTRIBUTE txn_type {
		TYPE = STRING
		LENGTH = 20
		REQUIRED = TRUE
		ALLOWED_VALUES = ["DEBIT", "CREDIT", "REFUND", "FEE"]
	}

	ATTRIBUTE status {
		TYPE = STRING
		LENGTH = 20
		REQUIRED = TRUE
		ALLOWED_VALUES = ["PENDING", "POSTED", "REVERSED", "DECLINED"]
	}

	PRIMARY KEY (txn_id)

	FOREIGN KEY (account_id)  REFERENCES Account(account_id)
	FOREIGN KEY (card_id)     REFERENCES Card(card_id)
	FOREIGN KEY (merchant_id) REFERENCES Merchant(merchant_id)
}

ENTITY Loan {
	DESCRIPTION = "Customer loans"

	ATTRIBUTE loan_id {
		TYPE = STRING
		LENGTH = 24
		REQUIRED = TRUE
	}

	ATTRIBUTE customer_id {
		TYPE = STRING
		LENGTH = 36
		REQUIRED = TRUE
	}

	ATTRIBUTE account_id {
		TYPE = STRING
		LENGTH = 24
		REQUIRED = TRUE
	}

	ATTRIBUTE principal_amount {
		TYPE = DECIMAL
		PRECISION = 18
		SCALE = 2
		REQUIRED = TRUE
	}

	ATTRIBUTE interest_rate {
		TYPE = DECIMAL
		PRECISION = 5
		SCALE = 2
		REQUIRED = TRUE
	}

	ATTRIBUTE start_date {
		TYPE = DATE
		REQUIRED = TRUE
	}

	ATTRIBUTE end_date {
		TYPE = DATE
		REQUIRED = TRUE
	}

	ATTRIBUTE status {
		TYPE = STRING
		LENGTH = 20
		REQUIRED = TRUE
		ALLOWED_VALUES = ["ACTIVE", "CLOSED", "DEFAULTED"]
	}

	PRIMARY KEY (loan_id)

	FOREIGN KEY (customer_id) REFERENCES Customer(customer_id)
	FOREIGN KEY (account_id)  REFERENCES Account(account_id)
}

ENTITY LoanPayment {
	DESCRIPTION = "Repayments for loans"

	ATTRIBUTE payment_id {
		TYPE = STRING
		LENGTH = 24
		REQUIRED = TRUE
	}

	ATTRIBUTE loan_id {
		TYPE = STRING
		LENGTH = 24
		REQUIRED = TRUE
	}

	ATTRIBUTE payment_date {
		TYPE = DATE
		REQUIRED = TRUE
	}

	ATTRIBUTE amount {
		TYPE = DECIMAL
		PRECISION = 18
		SCALE = 2
		REQUIRED = TRUE
	}

	ATTRIBUTE method {
		TYPE = STRING
		LENGTH = 20
		REQUIRED = TRUE
		ALLOWED_VALUES = ["TRANSFER", "CASH", "CARD"]
	}

	PRIMARY KEY (payment_id)

	FOREIGN KEY (loan_id) REFERENCES Loan(loan_id)
}

// ---------- RELATIONSHIPS ----------

RELATIONSHIP CustomerAccount {
	PARENT = Customer(customer_id)
	CHILD  = Account(customer_id)
	CARDINALITY = "1:N"
}

RELATIONSHIP BranchAccount {
	PARENT = Branch(branch_id)
	CHILD  = Account(branch_id)
	CARDINALITY = "1:N"
}

RELATIONSHIP AccountCard {
	PARENT = Account(account_id)
	CHILD  = Card(account_id)
	CARDINALITY = "1:N"
}

RELATIONSHIP AccountTransaction {
	PARENT = Account(account_id)
	CHILD  = Transaction(account_id)
	CARDINALITY = "1:N"
}

RELATIONSHIP CardTransaction {
	PARENT = Card(card_id)
	CHILD  = Transaction(card_id)
	CARDINALITY = "0:N"
}

RELATIONSHIP MerchantTransaction {
	PARENT = Merchant(merchant_id)
	CHILD  = Transaction(merchant_id)
	CARDINALITY = "0:N"
}

RELATIONSHIP CustomerLoan {
	PARENT = Customer(customer_id)
	CHILD  = Loan(customer_id)
	CARDINALITY = "1:N"
}

RELATIONSHIP AccountLoan {
	PARENT = Account(account_id)
	CHILD  = Loan(account_id)
	CARDINALITY = "1:N"
}

RELATIONSHIP LoanPaymentRel {
	PARENT = Loan(loan_id)
	CHILD  = LoanPayment(loan_id)
	CARDINALITY = "1:N"
}

